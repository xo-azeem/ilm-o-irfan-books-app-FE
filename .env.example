# Frontend env — anon key only (never put service_role in the app)
SUPABASE_URL=https://rwnmckrepvycydmtgvcq.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# RevenueCat public SDK keys — safe to ship. Never add the secret key or
# REVENUECAT_WEBHOOK_AUTH here: the webhook belongs to the backend.
REVENUECAT_IOS_KEY=appl_your_public_ios_key
REVENUECAT_ANDROID_KEY=goog_your_public_android_key

# Google Sign-In — public OAuth client ids from the Google Cloud project the
# backend's Supabase Google provider uses. WEB is what the native SDK mints the
# ID token for (both platforms). IOS is the iOS client; its reversed form is
# written into Info.plist as an URL scheme by `npm run google:ios-scheme`
# (EAS does this automatically). Leave both empty to hide Google sign-in.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
