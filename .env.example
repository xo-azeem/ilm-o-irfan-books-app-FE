# Frontend env — anon key only (never put service_role in the app)
SUPABASE_URL=https://rwnmckrepvycydmtgvcq.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Dev: true = signed-in users can read without a subscription.
# Publishing: false = an active subscription is required.
# Must match the same secret on the get-signed-pdf Edge Function.
# Changing this value requires rebuilding the native app (react-native-config).
ALLOW_PDF_WITHOUT_ENTITLEMENT=true
