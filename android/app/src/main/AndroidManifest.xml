<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      A dependency merges wifi as required; that blocks install on devices
      without Wi-Fi hardware. Mark it optional so mobile data is enough.
    -->
    <uses-feature
        android:name="android.hardware.wifi"
        android:required="false"
        tools:replace="android:required" />
    <!--
      expo-screen-capture merges READ_MEDIA_IMAGES (for screenshot *listening*).
      We only call usePreventScreenCapture (FLAG_SECURE), which needs none of
      that — and Play rejects READ_MEDIA_* when the system photo picker is
      enough for avatar/cover picks. Strip both media permissions from every
      merged library so the AAB stays policy-clean.
    -->
    <uses-permission
        android:name="android.permission.READ_MEDIA_IMAGES"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_VIDEO"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
        tools:node="remove" />
    <!--
      Legacy gallery access only below API 33. Avatar/cover picks use the
      system photo picker on 13+ (no broad storage permission).
    -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- Android 13+: the tray is opt-in; the app asks after the splash. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:largeHeap="true"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <!--
        The tray glyph, accent and default channel FCM uses when the app is
        in the background. Android renders a notification icon as a white
        silhouette, so the glyph is a flat vector rather than the launcher
        icon. Declared here rather than in firebase.json: RNFB would inject
        the same meta-data into the messaging *library's* manifest, whose
        release resource check cannot see this app's @color, and the release
        build fails on "color/notification_accent not found".
      -->
      <meta-data
        android:name="com.google.firebase.messaging.default_notification_icon"
        android:resource="@drawable/ic_notification" />
      <meta-data
        android:name="com.google.firebase.messaging.default_notification_color"
        android:resource="@color/notification_accent"
        tools:replace="android:resource" />
      <meta-data
        android:name="com.google.firebase.messaging.default_notification_channel_id"
        android:value="catalog"
        tools:replace="android:value" />
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/SplashTheme"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <!--
          ilmoirfan://… — Supabase auth emails (confirm, recover) and identity
          links redirect here; the backend allow-lists ilmoirfan://**.
          Handled by AuthLinkProvider. singleTask above keeps the link from
          opening a second copy of the app.
        -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="ilmoirfan" />
        </intent-filter>
      </activity>
    </application>
</manifest>
