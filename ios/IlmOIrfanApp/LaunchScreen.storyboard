                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleToFill" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="SplashGlow" translatesAutoresizingMaskIntoConstraints="NO" id="Gw1-2q-Rt6">
                                <rect key="frame" x="-33.5" y="196" width="460" height="460"/>
